[Unit]
Description=Counter-Strike 1.6 Dedicated Server
After=network.target

[Service]
Type=exec
User=hlds
WorkingDirectory=/opt/hlds/cs16
EnvironmentFile=/etc/hlds/cs16-server.conf
Environment="LD_LIBRARY_PATH=/opt/hlds/cs16"
ExecStart=/opt/hlds/cs16/hlds_linux -game cstrike ${hlds_args}
KillSignal=SIGINT
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
